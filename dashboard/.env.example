# ──────────────────────────────────────────────────────────────────────────────
# Dashboard Comercial — Sancho Gestão de Carreiras
# Copie este arquivo para .env.local e preencha os valores reais.
# ⚠️  NUNCA commit o arquivo .env.local
# ──────────────────────────────────────────────────────────────────────────────

# Token de autenticação do RD Station CRM
# Obtenha em: RD Station CRM → Configurações → Integrações → Token de API
RDCRM_TOKEN=seu_token_do_rd_station_crm_aqui

# ── Supabase ──────────────────────────────────────────────────────────────────
# Obtenha em: app.supabase.com → seu projeto → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# ⚠️  SERVICE_ROLE só é usado no servidor (Route Handlers). Jamais exponha no browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
